# MIOW LMS environment
# Copy to .env and provide private values. Do not commit .env.

# Generate three different URL-safe hex passwords with `openssl rand -hex 32`.
# The bootstrap password belongs only to the PostgreSQL initialization/operator role.
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
POSTGRES_APP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX

# Required native PostgreSQL connections for commands run on the host.
# Keep each password URL-safe (hex) and match it to its POSTGRES_* value above.
DATABASE_URL=postgres://miow_app:REPLACE_WITH_POSTGRES_APP_PASSWORD@localhost:5432/miow
MIGRATOR_DATABASE_URL=postgres://miow_migrator:REPLACE_WITH_POSTGRES_MIGRATOR_PASSWORD@localhost:5432/miow
PG_POOL_MAX=5

# Local persistent file storage.
STORAGE_PATH=./storage
APP_BIND_ADDRESS=127.0.0.1

# Use a registry tag when building for linux/arm64 elsewhere and deploying to the Pi.
APP_IMAGE=miow-lms:local

# Required: generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Optional hardware API key.
HARDWARE_API_KEY=

# Optional AI service configuration.
OPENCODE_API_KEY=
# AI_GATEWAY_KEY=
# AI_BASE_URL=https://opencode.ai/zen/go/v1

# Optional Google integration; these values are public client settings.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Optional service URLs and logging.
SITE_URL=https://akios.site
# VITE_DEBUG_LOGS=false
# DEBUG_LOGS=false
