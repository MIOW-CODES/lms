# MIOW LMS environment
# Copy to .env and provide private values. Do not commit .env.

# Required native PostgreSQL database connection.
DATABASE_URL=postgres://miow_app:CHANGE_ME@localhost:5432/miow
PG_POOL_MAX=5

# Local persistent file storage.
STORAGE_PATH=./storage

# Required: generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Optional hardware API key.
HARDWARE_API_KEY=

# Optional AI service configuration.
OPENCODE_API_KEY=
# AI_GATEWAY_KEY=
# AI_BASE_URL=https://opencode.ai/zen/go/v1

# Optional Google integration; these values are public client settings.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Optional service URLs and logging.
# SITE_URL=https://akios.site
# VITE_DEBUG_LOGS=false
# DEBUG_LOGS=false
