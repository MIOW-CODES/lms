# MIOW — Environment variables
# Copy to .env and fill values. Never commit .env.
# Generate SESSION_SECRET: openssl rand -hex 32  (32+ random hex chars)

# ── Option A: Supabase (cloud) ──────────────────────────────────────
# Set these to use Supabase as the database backend.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ── Option B: Local Postgres (self-hosted) ──────────────────────────
# Set DATABASE_URL to use a local or remote Postgres instance.
DATABASE_URL=postgres://miow:***@localhost:5432/miow
# Optional: direct postgres without URL
# PGHOST=localhost
# PGPORT=5432
# PGUSER=miow
# PGPASSWORD=miow_dev_password
# PGDATABASE=miow

# ── Storage ──────────────────────────────────────────────────────────
# Where local file storage lands (avatars, course-materials)
STORAGE_PATH=./storage

# ── Optional services ───────────────────────────────────────────────
# Redis for cross-instance rate-limit (5/15m). If unset, uses in-memory.
# REDIS_URL=redis://localhost:6379

# ── Auth & API keys ─────────────────────────────────────────────────
# Required: 64-char hex string. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Session lifetime in hours (default: 12). 0 = token never expires.
# SESSION_TTL_HOURS=12

# Hardware auth (optional, for biometric kiosk)
HARDWARE_API_KEY=

# AI chat — set either one (OPENCODE_API_KEY takes precedence)
OPENCODE_API_KEY=
# AI_GATEWAY_KEY=

# ── Sitemap ──────────────────────────────────────────────────────────
# Public base URL for sitemap.xml generation
# BASE_URL=https://your-domain.com

# ── Google Docs import ───────────────────────────────────────────────
# Enables the "Import from Google Docs" button on the Create Worksheet page.
# 1. Create a project at https://console.cloud.google.com
# 2. Enable Google Docs API + Google Picker API
# 3. Create OAuth 2.0 Web Application credentials
# 4. Set VITE_GOOGLE_CLIENT_ID (OAuth Client ID) and VITE_GOOGLE_API_KEY (API Key)
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=

# ── Debug logging ───────────────────────────────────────────────────
# Set to true to see console.debug in browser + server
# VITE_DEBUG_LOGS=true
# DEBUG_LOGS=true
